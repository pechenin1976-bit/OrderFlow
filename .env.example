# --- Local / VPS API bind (defaults OK for prod behind nginx) ---
ORDERFLOW_API_HOST=127.0.0.1
ORDERFLOW_API_PORT=8080
ORDERFLOW_PUBLISH_INTERVAL_SEC=5.0

# --- Production (VPS): do NOT set ORDERFLOW_API_KEYS ---
# Subscribers auth with license keys from @quantilan_bot (plan pro_orderflow).
# Dev token is blocked at startup unless ORDERFLOW_ALLOW_INSECURE_DEV=true.
#
# ORDERFLOW_API_KEYS=
# ORDERFLOW_ALLOW_INSECURE_DEV=false

# --- Local dev only (uncomment both) ---
# ORDERFLOW_ALLOW_INSECURE_DEV=true
# ORDERFLOW_API_KEYS=dev-token-change-me

# License server — same SERVICE_TOKEN as license server .env
ORDERFLOW_LICENSE_SERVER_URL=http://127.0.0.1:8000
ORDERFLOW_LICENSE_SERVICE_TOKEN=
ORDERFLOW_LICENSE_VALIDATE=true
ORDERFLOW_LICENSE_CACHE_SEC=60

# Optional CORS (default: quantilan.com + www)
# ORDERFLOW_CORS_ORIGINS=https://quantilan.com,https://www.quantilan.com

ORDERFLOW_SEND_SIGNALS=false
ORDERFLOW_SIGNALS_SOCK=/tmp/signals.sock
ORDERFLOW_BAND_BPS=5.0
ORDERFLOW_PROFILE_RANGE_PCT=0.8
ORDERFLOW_PROFILE_STEPS=10
