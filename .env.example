ORDERFLOW_API_HOST=127.0.0.1
ORDERFLOW_API_PORT=8080
ORDERFLOW_PUBLISH_INTERVAL_SEC=2.0

# Dev/admin bypass (comma-separated). Subscribers use license keys from @quantilan_bot.
ORDERFLOW_API_KEYS=dev-token-change-me

# License server — plan pro_orderflow (same SERVICE_TOKEN as license server .env)
ORDERFLOW_LICENSE_SERVER_URL=http://127.0.0.1:8000
ORDERFLOW_LICENSE_SERVICE_TOKEN=local-service-token
ORDERFLOW_LICENSE_VALIDATE=true
ORDERFLOW_LICENSE_CACHE_SEC=60

ORDERFLOW_SEND_SIGNALS=false
ORDERFLOW_SIGNALS_SOCK=/tmp/signals.sock
ORDERFLOW_BAND_BPS=5.0
# Дефолт если UI не передал range (на странице: 1% / 3% / 5%)
ORDERFLOW_PROFILE_RANGE_PCT=1
ORDERFLOW_PROFILE_STEPS=10
